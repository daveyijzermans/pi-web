#!/usr/bin/env node
// Fake `pi --mode rpc` for e2e tests. Speaks the line-delimited JSON protocol
// the real worker expects (see internal/rpc/{client,worker}.go) so chat flows
// can be exercised without the real pi binary or any API keys.
//
// Behavior:
//   - switch_session: remember the session file path.
//   - get_state / set_model / set_thinking_level / abort: acknowledge.
//   - prompt: ack, then append a user turn + a deterministic assistant reply to
//     the session JSONL (like real pi owns the file) and emit stream + agent_end
//     events. The browser picks up the reply via the fsnotify->SSE reload path.

import fs from "node:fs";
import readline from "node:readline";

let sessionPath = "";
let model = { id: "claude-opus-4-7", name: "Opus", provider: "anthropic" };
let thinkingLevel = "medium";
let idSeq = 0;

// Deterministic slash-command set for the get_commands rpc. Includes one of
// each source so the palette spec can assert that extension commands are
// filtered out while prompt + skill commands are surfaced.
const COMMANDS = [
  { name: "btw", description: "Open a side-chat popover", source: "extension" },
  { name: "workon", description: "Start working on a task", source: "prompt" },
  { name: "skill:memory", description: "Project memory skill", source: "skill" },
];

function send(obj) {
  process.stdout.write(JSON.stringify(obj) + "\n");
}

function respond(id, command, data = {}) {
  send({ type: "response", id, command, success: true, data });
}

function nextId() {
  return `stub-${Date.now().toString(36)}-${idSeq++}`;
}

function lastEntryId() {
  try {
    const lines = fs.readFileSync(sessionPath, "utf8").split("\n").filter((l) => l.trim());
    for (let i = lines.length - 1; i >= 0; i--) {
      const e = JSON.parse(lines[i]);
      if (e && e.id) return e.id;
    }
  } catch {
    /* file may not exist yet */
  }
  return null;
}

function appendEntry(entry) {
  fs.appendFileSync(sessionPath, JSON.stringify(entry) + "\n");
}

function messageEntry(role, text, parentId) {
  const id = nextId();
  return {
    id,
    entry: {
      type: "message",
      id,
      parentId,
      timestamp: new Date().toISOString(),
      message: { role, content: [{ type: "text", text }], timestamp: Date.now() },
    },
  };
}

// A "[[slow:NNNN]]" marker in a prompt keeps the worker in the running state for
// NNNN ms before emitting agent_end, giving steer/queue e2e tests a window to
// interact while a response is in flight. The marker is stripped from the text
// written to the session.
let activeSlowRun = false;

function parseDelay(raw) {
  const m = /\s*\[\[slow:(\d+)\]\]\s*/.exec(raw);
  if (!m) return { text: raw, delay: 0 };
  return { text: (raw.slice(0, m.index) + raw.slice(m.index + m[0].length)).trim(), delay: Number(m[1]) };
}

// A "[[tooly:GAP]]" marker scripts a realistic multi-message tool turn,
// mirroring real pi's event + flush order (verified against a live
// `pi --mode rpc` trace):
//   message 1: text streams, text_end, tool-call args stream silently,
//              flush [text, toolCall] at message_end; toolResult after GAP ms.
//   message 2: text streams, text_end, then a LONG silent args phase
//              (ARGS_MS) before its [text, toolCall] entry flushes — the
//              window where streamed text exists only in the preview.
//   message 3: short text, flushed, then agent_end.
// The streaming-preview spec asserts streamed content never disappears from
// the page mid-turn, including under slow /api/session fetches.
function parseTooly(raw) {
  const m = /\s*\[\[tooly:(\d+)\]\]\s*/.exec(raw);
  if (!m) return null;
  return { text: (raw.slice(0, m.index) + raw.slice(m.index + m[0].length)).trim(), gap: Number(m[1]) };
}

const TOOLY_TEXT_1 = "Alpha beta gamma.";
const TOOLY_TEXT_2 = "Delta epsilon zeta.";
const TOOLY_TEXT_3 = "Omega finale.";
const TOOLY_ARGS_MS = 3000;

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function textDelta(delta) {
  send({ type: "message_update", assistantMessageEvent: { type: "text_delta", delta } });
}

async function streamText(text) {
  const words = text.split(/(?<= )/);
  for (const word of words) {
    textDelta(word);
    await sleep(60);
  }
  send({ type: "message_update", assistantMessageEvent: { type: "text_end", content: text } });
}

async function streamThinking(text) {
  send({ type: "message_update", assistantMessageEvent: { type: "thinking_start" } });
  const words = text.split(/(?<= )/);
  for (const word of words) {
    send({ type: "message_update", assistantMessageEvent: { type: "thinking_delta", delta: word } });
    await sleep(60);
  }
  send({ type: "message_update", assistantMessageEvent: { type: "thinking_end", content: text } });
}

function toolCallEntry(parentId, text, callId) {
  const id = nextId();
  appendEntry({
    type: "message",
    id,
    parentId,
    timestamp: new Date().toISOString(),
    message: {
      role: "assistant",
      content: [
        { type: "text", text },
        { type: "toolCall", id: callId, name: "bash", arguments: { command: "true" } },
      ],
      timestamp: Date.now(),
    },
  });
  return id;
}

function toolResultEntry(parentId, callId) {
  const id = nextId();
  appendEntry({
    type: "message",
    id,
    parentId,
    timestamp: new Date().toISOString(),
    message: {
      role: "toolResult",
      toolCallId: callId,
      toolName: "bash",
      content: [{ type: "text", text: "ok" }],
      isError: false,
      timestamp: Date.now(),
    },
  });
  return id;
}

async function runToolyTurn(userText, gap) {
  const user = messageEntry("user", userText, lastEntryId());
  appendEntry(user.entry);

  // Message 1: streamed text, short args phase, flush [text, toolCall].
  await streamText(TOOLY_TEXT_1);
  await sleep(200); // args stream (silent — no preview events)
  const call1 = `stub-call-${idSeq++}`;
  const a1 = toolCallEntry(user.id, TOOLY_TEXT_1, call1);
  send({ type: "message_end" });

  // The "tool" runs: silent for GAP ms, then its result lands.
  await sleep(gap);
  const tr1 = toolResultEntry(a1, call1);

  // Message 2: streamed text, then a LONG silent args phase before the
  // entry flushes — during this window the text exists only in the preview.
  await sleep(400);
  await streamText(TOOLY_TEXT_2);
  await sleep(TOOLY_ARGS_MS);
  const call2 = `stub-call-${idSeq++}`;
  const a2 = toolCallEntry(tr1, TOOLY_TEXT_2, call2);
  send({ type: "message_end" });
  const tr2 = toolResultEntry(a2, call2);

  // Message 2b: a THINKING-ONLY message (thinking + tool call, no answer
  // text). Its preview has no text to protect, so it must not strand in the
  // preview host — its canonical entry renders in #messages.
  await sleep(300);
  await streamThinking("Pondering the next move carefully.");
  await sleep(200);
  const call2b = `stub-call-${idSeq++}`;
  const a2bParent = nextId();
  appendEntry({
    type: "message",
    id: a2bParent,
    parentId: tr2,
    timestamp: new Date().toISOString(),
    message: {
      role: "assistant",
      content: [
        { type: "thinking", thinking: "Pondering the next move carefully." },
        { type: "toolCall", id: call2b, name: "bash", arguments: { command: "true" } },
      ],
      timestamp: Date.now(),
    },
  });
  send({ type: "message_end" });
  const tr2b = toolResultEntry(a2bParent, call2b);

  // Message 3: quick closing text, then the turn ends.
  await sleep(300);
  await streamText(TOOLY_TEXT_3);
  appendEntry(messageEntry("assistant", TOOLY_TEXT_3, tr2b).entry);
  send({ type: "message_end" });
  send({ type: "turn_end" });
  send({ type: "agent_end" });
}

function writeTurn(userText, reply) {
  if (!sessionPath) return;
  const user = messageEntry("user", userText, lastEntryId());
  appendEntry(user.entry);
  appendEntry(messageEntry("assistant", reply, user.id).entry);
}

function handlePrompt(cmd) {
  // Ack the prompt command first so POST /api/chat returns promptly.
  respond(cmd.id, "prompt", {});

  const raw = typeof cmd.message === "string" ? cmd.message : JSON.stringify(cmd.message ?? "");
  const tooly = parseTooly(raw);
  if (tooly) {
    void runToolyTurn(tooly.text, tooly.gap);
    return;
  }
  const { text: userText, delay } = parseDelay(raw);
  const reply = `Stub reply: ${userText}`;

  // A prompt that lands while a slow run is in flight is a steer: real pi folds
  // it into the active turn rather than starting a new one, so write the turn
  // but let the original run own the agent_end / completion signal.
  if (activeSlowRun) {
    writeTurn(userText, reply);
    send({ type: "message_update", assistantMessageEvent: { type: "text_delta", text: reply } });
    return;
  }

  if (delay > 0) {
    activeSlowRun = true;
    // Real pi appends the user message as soon as the turn starts (the file
    // write is what lights the server's running indicator via the watcher);
    // only the assistant reply waits for the slow window.
    const user = sessionPath ? messageEntry("user", userText, lastEntryId()) : null;
    if (user) appendEntry(user.entry);
    send({ type: "message_update", assistantMessageEvent: { type: "text_delta", text: "working…" } });
    setTimeout(() => {
      if (user) appendEntry(messageEntry("assistant", reply, user.id).entry);
      send({ type: "message_end" });
      send({ type: "turn_end" });
      send({ type: "agent_end" });
      activeSlowRun = false;
    }, delay);
    return;
  }

  // Mimic real pi taking ownership of the session file.
  setTimeout(() => {
    writeTurn(userText, reply);
    // Best-effort stream signals; shape mismatch is harmless to the worker.
    send({ type: "message_update", assistantMessageEvent: { type: "text_delta", text: reply } });
    send({ type: "message_end" });
    send({ type: "turn_end" });
    send({ type: "agent_end" });
  }, 30);
}

function handle(cmd) {
  switch (cmd.type) {
    case "switch_session":
      sessionPath = cmd.sessionPath || sessionPath;
      respond(cmd.id, "switch_session", {});
      break;
    case "get_state":
      respond(cmd.id, "get_state", { thinkingLevel, model });
      break;
    case "set_model":
      model = { id: cmd.modelId, name: cmd.modelId, provider: cmd.provider };
      respond(cmd.id, "set_model", model);
      break;
    case "set_thinking_level":
      thinkingLevel = cmd.level || thinkingLevel;
      respond(cmd.id, "set_thinking_level", { thinkingLevel });
      break;
    case "abort":
      respond(cmd.id, "abort", {});
      send({ type: "agent_end" });
      break;
    case "get_commands":
      respond(cmd.id, "get_commands", { commands: COMMANDS });
      break;
    case "prompt":
      handlePrompt(cmd);
      break;
    default:
      if (cmd.id) respond(cmd.id, cmd.type || "unknown", {});
  }
}

const rl = readline.createInterface({ input: process.stdin });
rl.on("line", (line) => {
  const trimmed = line.trim();
  if (!trimmed) return;
  let cmd;
  try {
    cmd = JSON.parse(trimmed);
  } catch {
    return;
  }
  if (cmd && cmd.id) handle(cmd);
});
rl.on("close", () => process.exit(0));
